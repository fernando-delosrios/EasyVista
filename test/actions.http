    "identity": "993"
  },
  "config": {{config}}
}
###
# Account update
POST {{url}}
Content-Type: application/json

{
  "type": "std:account:update",
  "input": {"changes":[{"attribute":"PROFIL_ID","op":"Add","value":"10"}], "identity": "19241"},
  "config": {{config}}
}
