{
    "name": "easyvista",
    "version": "0.2.1",
    "main": "dist/index.js",
    "scripts": {
        "clean": "shx rm -rf ./dist",
        "prebuild": "npm run clean",
        "build": "npx ncc build ./src/index.ts -o ./dist -m -C",
        "dev": "spcx run dist/index.js",
        "debug": "spcx run dist/index.js",
        "prettier": "npx prettier --write .",
        "test": "jest --coverage",
        "prepack-zip": "npm ci && npm run build",
        "pack-zip": "spcx package"
    },
    "private": true,
    "dependencies": {
        "@sailpoint/connector-sdk": "1.1.38",
        "axios": "^1.7.9",
        "axios-cache-interceptor": "^1.6.2",
        "axios-request-throttle": "^1.0.0",
        "axios-retry": "^3.5.1",
        "date-fns": "^2.30.0",
        "easyvista": "file:"
    },
    "devDependencies": {
        "@vercel/ncc": "^0.38.1",
        "prettier": "^3.1.0",
        "shx": "^0.3.4",
        "typescript": "^5.2.2"
    },
    "prettier": {
        "printWidth": 120,
        "trailingComma": "es5",
        "tabWidth": 4,
        "semi": false,
        "singleQuote": true
    }
}